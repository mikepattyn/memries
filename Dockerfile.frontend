# syntax=docker/dockerfile:1

FROM node:20-alpine AS pruner
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm dlx turbo@2.10.12 prune @memries/frontend --docker \
    && node docker/fill-prune-output.mjs @memries/frontend

FROM node:20-alpine AS builder
WORKDIR /repo
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable
COPY --from=pruner /repo/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm exec turbo run build --filter=@memries/frontend

FROM nginx:1.27-alpine
COPY --from=builder /repo/apps/frontend/dist /usr/share/nginx/html
COPY --from=builder /repo/apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf
