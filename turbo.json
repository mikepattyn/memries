{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "LOCALAPPDATA",
    "GOCACHE",
    "GOMODCACHE",
    "GOPATH",
    "GOROOT",
    "GOPROXY",
    "GOSUMDB",
    "GOTOOLCHAIN",
    "GOFLAGS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"]
    },
    "test": {},
    "lint": {},
    "format": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
