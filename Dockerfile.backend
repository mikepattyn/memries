# syntax=docker/dockerfile:1

FROM node:20-alpine AS pruner
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm dlx turbo@2.10.12 prune @memries/backend --docker \
    && node docker/fill-prune-output.mjs @memries/backend

FROM node:20-bookworm AS builder
WORKDIR /repo
ARG GO_VERSION=1.23.6
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates git \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH=/go
ENV CGO_ENABLED=0
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable
COPY --from=pruner /repo/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .
WORKDIR /repo/apps/backend
RUN --mount=type=cache,id=gomod,target=/go/pkg/mod \
    go mod download
WORKDIR /repo
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    --mount=type=cache,id=gomod,target=/go/pkg/mod \
    pnpm exec turbo run build --filter=@memries/backend

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /repo/apps/backend/bin/server /usr/local/bin/server
COPY --from=builder /repo/apps/backend/bin/indexer /usr/local/bin/indexer
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["server"]
